SMARTGATE_OPERATOR_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# Optional
SMARTGATE_KILL_ALLOW=
SMARTGATE_SLACK_WEBHOOK_URL=
SMARTGATE_SLACK_SIGNING_SECRET=
