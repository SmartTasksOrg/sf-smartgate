<Project Sdk="Microsoft.NET.Sdk">
  <!-- SmartGate for .NET. Not published on NuGet; reference this project from a clone. No package dependencies. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartGate</RootNamespace>
    <AssemblyName>SfSmartGate</AssemblyName>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="policy.default.json" LogicalName="policy.default.json" />
  </ItemGroup>
</Project>
