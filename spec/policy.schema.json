{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SmartTasksOrg/sf-smartgate/spec/policy.schema.json",
  "title": "SmartGate policy, version 1",
  "type": "object",
  "required": ["schema", "cost_bands", "levels"],
  "properties": {
    "schema": {"const": "smartgate.policy/v1"},
    "cost_bands": {
      "type": "array", "minItems": 1,
      "description": "First band with cost_usd <= max_usd gives the score; only the last band has max_usd null. max_usd must increase.",
      "items": {
        "type": "object", "required": ["max_usd", "score"],
        "properties": {
          "max_usd": {"type": ["number", "null"]},
          "score": {"type": "integer", "minimum": 0, "maximum": 10}
        }
      }
    },
    "action_floors": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 10}},
    "default_floor": {"type": "integer", "minimum": 0, "maximum": 10},
    "irreversible_bonus": {"type": "integer", "minimum": 0, "maximum": 10},
    "levels": {
      "type": "array", "minItems": 1,
      "description": "max_score must increase and the last must be 10; names unique.",
      "items": {
        "type": "object", "required": ["name", "max_score", "friction"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "max_score": {"type": "integer", "minimum": 0, "maximum": 10},
          "friction": {"enum": ["allow", "prompt", "block"]}
        }
      }
    },
    "cascade": {
      "type": ["object", "null"],
      "required": ["window_ms", "max_actions", "max_cumulative_risk", "escalate_to"],
      "properties": {
        "window_ms": {"type": "integer", "minimum": 1},
        "max_actions": {"type": "integer", "minimum": 1},
        "max_cumulative_risk": {"type": "integer", "minimum": 0},
        "escalate_to": {"enum": ["allow", "prompt", "block"]}
      }
    },
    "low_confidence": {
      "type": ["object", "null"],
      "required": ["below_permille", "escalate_to"],
      "properties": {
        "below_permille": {"type": "integer", "minimum": 0, "maximum": 1000},
        "escalate_to": {"enum": ["allow", "prompt", "block"]}
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1},
        "on_timeout": {"enum": ["reject", "approve"]}
      }
    },
    "fallback": {"enum": ["allow", "block", "block_high"]}
  }
}
